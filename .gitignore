# =========================================================================
# Unity Generated Folders & Files
# =========================================================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Cc]aptures/
/[Mm]emoryCaptures/
/[Logs]/
/[Vv]ariants/
/UserSettings/

# Asset store packages can be downloaded paths, keep the metadata but ignore the raw cache
/Assets/AssetStoreTools*

# =========================================================================
# Visual Studio / Rider / VS Code Project Files
# =========================================================================
# Ignore solutions and project files generated by IDEs (Unity re-generates these automatically)
/*.csproj
/*.sln
/*.suo
/*.user
/*.userprefs
/*.pidb
/*.booproj
/*.svd
/*.pdb
/*.opendb
/*.VC.db

# IDE specific folders
.vs/
.gradle/
.idea/
.rider/
*.contentproj
*.unresolved

# =========================================================================
# OS Generated Files
# =========================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# =========================================================================
# Crashlytics / Bug reporting logs
# =========================================================================
sysinfo.txt
crashlytics-build.properties

# =========================================================================
# Local Configuration / Secrets (If you use any)
# =========================================================================
/[Aa]ssets/[Pp]lugins/Signatures*
.env
